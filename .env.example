# Copy this file to .env and replace the placeholder values.
# NEVER commit the real .env file.

# SQLite (development) — change to a PostgreSQL URL for production:
# postgresql://user:password@localhost:5432/restaurant_db
DATABASE_URL=sqlite://./dev.db

# Generate a strong random key for JWT signing, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# "development" | "production"
APP_ENV=development
